# Local SQLite database on a ZFS dataset mounted in the FreeBSD jail (never NFS).
KCAL_DATABASE_PATH=/var/db/kcal/kcal.sqlite3
# migrate requires only KCAL_DATABASE_PATH. Flags override environment settings.
# Private listener (default 127.0.0.1:8080); Caddy owns public TLS.
KCAL_LISTEN_ADDRESS=127.0.0.1:8080
# Absolute HTTPS base URL, optionally with a deployment path; resource is BASE/mcp.
KCAL_PUBLIC_BASE_URL=https://kcal.example.com
# Pocket ID issuer URL and the configured OIDC client ID.
KCAL_OIDC_ISSUER=https://id.example.com
# Token audience is independent of the public resource URL; opaque IDs are valid.
KCAL_OIDC_AUDIENCE=kcal
# Optional for serve: leave ALL three integration settings empty to disable Withings.
# sync-withings requires all three; partial integration is rejected by both commands.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Exactly 64 hexadecimal characters; keep stable and never commit a real key.
KCAL_TOKEN_ENCRYPTION_KEY=
# Optional log level: debug, info (default), warning, error, quiet.
KCAL_LOG_LEVEL=info
