opam-version: "2.0"
name: "kcal"
version: "dev"
synopsis: "Portable local calorie ledger"
maintainer: "Gustaf Rydholm <gustaf.rydholm@gmail.com>"
authors: "Gustaf Rydholm <gustaf.rydholm@gmail.com>"
license: "MIT"
homepage: "https://github.com/aktersnurra/kcal"
bug-reports: "https://github.com/aktersnurra/kcal/issues"
dev-repo: "git+https://github.com/aktersnurra/kcal.git"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.24"}
  "base" {>= "v0.17" & < "v0.18~"}
  "core" {>= "v0.17" & < "v0.18~"}
  "core_unix" {>= "v0.17" & < "v0.18~"}
  "ppx_jane" {>= "v0.17" & < "v0.18~"}
  "ocamlformat" {= "0.29.0" & with-dev-setup}
  "eio"
  "eio_main"
  "eio_posix"
  "cohttp-eio"
  "tls-eio"
  "httpun-eio"
  "jose"
  "mirage-crypto"
  "mirage-crypto-rng"
  "digestif"
  "x509"
  "base64"
  "uri"
  "sqlite3"
  "yojson"
  "ptime"
  "uuidm"
  "cmdliner"
  "logs"
  "alcotest" {with-test}
  "hegel" {with-test}
  "ppx_hegel_test" {with-test}
]
build: [ ["dune" "build" "-p" name] ]
