(library
 (name kcal_store)
 (wrapped false)
 (libraries
  kcal_infrastructure
  kcal_domain
  kcal_kernel
  base
  ptime
  sqlite3
  logs
  yojson
  unix))

(rule
 (target embedded_migrations.ml)
 (deps
  (glob_files ../../migrations/[0-9]*.sql))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../../tools/embed_migrations.exe} %{deps}))))
