; Umbrella over the six layer libraries, so entry points and tests depend on one name.

(library
 (name kcal)
 (wrapped false)
 (modules)
 (libraries
  (re_export kcal_kernel)
  (re_export kcal_domain)
  (re_export kcal_store)
  (re_export kcal_application)
  (re_export kcal_mcp)
  (re_export kcal_edge)))

; Executable/test modules have no exported API; every library module must.

(env
 (_
  (flags
   (:standard -w @70))))
